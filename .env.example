# HTTP
PORT=3000

# Sentry - paste the DSN of the project you want to debug (e.g. corunner-mcp-smoke)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional; defaults to the current git short SHA
SENTRY_RELEASE=

# Local storage (SQLite file is created on boot and seeded with demo orders)
DATABASE_PATH=./data/demo.db
LOG_LEVEL=info

# Redis is intentionally NOT running in the demo - `?fail=redis` uses this to produce ECONNREFUSED
REDIS_URL=redis://127.0.0.1:6399

# How long the simulated connection-pool wait lasts before P2024 is thrown
POOL_TIMEOUT_MS=5000
