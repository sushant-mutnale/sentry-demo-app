{
  "name": "sentry-demo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Demo service that generates realistic Sentry telemetry (logs, traces, errors) and pairs with a tiny browser UI.",
  "type": "module",
  "engines": {
    "node": ">=22.7.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "dev:watch": "node --env-file=.env --disable-warning=ExperimentalWarning --watch --import tsx src/server.ts",
    "start": "node --env-file=.env --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^10.0.0",
    "@sentry/node": "^10.0.0",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
